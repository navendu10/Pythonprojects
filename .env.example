# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Gmail account that sends email (contact forms, news digest)
EMAIL_USERNAME=your.address@gmail.com
# Gmail APP PASSWORD: https://myaccount.google.com/apppasswords (needs 2-step verification)
EMAIL_PASSWORD=your-app-password
# Who receives the email. Optional, defaults to EMAIL_USERNAME.
EMAIL_RECEIVER=

# Free API key from https://newsapi.org (news digest only)
NEWS_API_KEY=your-newsapi-key
